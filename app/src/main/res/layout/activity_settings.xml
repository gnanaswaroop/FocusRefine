<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Unified Header with App Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="App Logo"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="FocusFlow Settings"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnHome"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Back"
                android:textAllCaps="false"/>
        </LinearLayout>

        <!-- AI Support Status Note -->
        <TextView
            android:id="@+id/tvAiStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#FFF3E0"
            android:padding="12dp"
            android:textSize="13sp"
            android:textColor="#E65100" />

        <!-- MediaPipe AI Engine Toggle Switch -->
        <Switch
            android:id="@+id/switchUseAiModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:checked="true"
            android:text="Use MediaPipe On-Device AI Engine"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Appearance / Theme Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Appearance"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Theme Mode"
            android:textSize="14sp"/>

        <Spinner
            android:id="@+id/spinnerTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp"/>

        <!-- Retention Cleanup Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Retention"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear history older than X days"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etRetentionDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:inputType="number"
            android:hint="Retention in days (e.g. 7)"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp"/>

        <!-- Commute Mode Section -->
        <CheckBox
            android:id="@+id/cbCommuteEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Enable Commute Mode"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etCommutePrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Commute Mode Prompt / Keywords"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <!-- Do Not Disturb Mode Section -->
        <CheckBox
            android:id="@+id/cbDndEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Enable Do Not Disturb (DND) Mode"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etDndPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="DND Mode Prompt / Keywords"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider"
            android:layout_marginBottom="16dp"/>

        <!-- Custom Modes Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Custom Mode"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etNewCustomModeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom Mode Name (e.g. Workout)"
            android:minHeight="48dp"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etNewCustomModePrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Custom Mode Prompt / Filtering Rules"
            android:minHeight="60dp"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/btnAddCustomMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add Custom Mode"/>

        <TextView
            android:id="@+id/tvCustomModesList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Custom Modes: None"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"/>

        <Button
            android:id="@+id/btnClearCustomModes"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear All Custom Modes"/>

        <Button
            android:id="@+id/btnSendSamples"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Send Sample Notifications"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>
