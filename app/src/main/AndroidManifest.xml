<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: lets the focus-session countdown show as a status bar chip. Normal permission, no data access. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Privacy guarantee: the app has no network access. MediaPipe's tasks-core pulls in Google's
         datatransport library, which declares these; strip them so the OS blocks every socket. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusRefine">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusRefine">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true" />

        <activity
            android:name=".ConfigureModesActivity"
            android:exported="true" />

        <activity
            android:name=".LearnedRulesActivity"
            android:exported="true" />

        <activity
            android:name=".NotificationDetailActivity"
            android:exported="true" />

        <activity
            android:name=".ContextModesActivity"
            android:exported="true" />

        <activity
            android:name=".PrivacyInsightsActivity"
            android:exported="true" />

        <activity
            android:name=".HelpActivity"
            android:exported="false" />

        <activity
            android:name=".ChangelogActivity"
            android:exported="false" />

        <activity
            android:name=".LegalActivity"
            android:exported="false" />

        <service
            android:name=".NotificationFilterService"
            android:label="FocusRefine Notification Filter"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".AutoActivationReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".NotificationToggleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.focusrefine.app.ACTION_TOGGLE_SERVICE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ModeSessionReceiver"
            android:exported="false" />

    </application>
</manifest>
