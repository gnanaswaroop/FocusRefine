<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: lets the focus-session countdown show as a status bar chip. Normal permission, no data access. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
        No network access, by design. The two lines below do NOT grant INTERNET or ACCESS_NETWORK_STATE; they block them.
        A library's manifest can declare these permissions, and the manifest merger would then add them to the app without
        anyone choosing it. tools:node="remove" tells the merger to drop them from the final manifest, so the app never
        requests them, whichever dependency adds them now or in the future. PrivacyGuardsTest fails the build if either
        permission is requested, and checks that a socket cannot connect. Do not remove these lines to "fix" a build error:
        find the library that adds the permission and replace or configure it instead.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- LiteRT and asset-delivery declare this foreground service type. FocusRefine runs no data sync service, so it is removed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FocusRefine">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FocusRefine">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity
            android:name=".SettingsActivity"
            android:exported="true" />

        <activity
            android:name=".ConfigureModesActivity"
            android:exported="true" />

        <activity
            android:name=".LearnedRulesActivity"
            android:exported="true" />

        <activity
            android:name=".NotificationDetailActivity"
            android:exported="true" />

        <activity
            android:name=".ContextModesActivity"
            android:exported="true" />

        <activity
            android:name=".PrivacyInsightsActivity"
            android:exported="true" />

        <activity
            android:name=".HelpActivity"
            android:exported="false" />

        <activity
            android:name=".ChangelogActivity"
            android:exported="false" />

        <activity
            android:name=".LegalActivity"
            android:exported="false" />

        <service
            android:name=".NotificationFilterService"
            android:label="FocusRefine Notification Filter"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:foregroundServiceType="specialUse"
            android:exported="true">
            <!-- Play review: the special use the service needs its foreground type for. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the on-device notification filter running so it can decide, in real time, which notifications to show and which to mute." />
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".AutoActivationReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".NotificationToggleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.focusrefine.app.ACTION_TOGGLE_SERVICE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ModeSessionReceiver"
            android:exported="false" />

    </application>
</manifest>
