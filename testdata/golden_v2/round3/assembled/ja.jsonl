{"id": "ja-test-03039", "split": "test", "lang": "ja", "region": "JP", "package": "jp.naver.line.android", "app_name": "LINE", "app_category": "messaging", "usecase": "group_forward", "sender_type": "group", "title": "マンション住民連絡 - 鈴木", "text": "【転送】明日から正面玄関が工事で閉鎖されるそうです。車は裏口からの出入りになるので、今のうちに予定を立ててください。（友人からの転送で、まだ確認は取れていません）すぐに知り合いにも回してください。管理会社の人が話していたそうなので、詳しくは掲示板を見てください。慌てなくても大丈夫です。", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-ja-group_forward-1", "provenance": "authored-r3-v1"}
{"id": "ja-dev-03040", "split": "dev", "lang": "ja", "region": "JP", "package": "com.whatsapp", "app_name": "WhatsApp", "app_category": "messaging", "usecase": "group_forward", "sender_type": "group", "title": "家族グループ - 叔父さん", "text": "【転送】おはようございます！今日も良い一日になりますように。この画像を受け取ったら、10人に送ってください。そうすると今日中に大きなプレゼントが届きます！すぐ送らないと損をしますよ〜全員に回してください。皆さんの健康と幸せを願っています！私はもう20人に送りましたが、まだプレゼントは届いていません。", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-ja-group_forward-2", "provenance": "authored-r3-v1"}
{"id": "ja-test-03041", "split": "test", "lang": "ja", "region": "JP", "package": "jp.naver.line.android", "app_name": "LINE", "app_category": "messaging", "usecase": "group_forward", "sender_type": "group", "title": "地域安全 - 町内会", "text": "【転送】最近このあたりで、知らない人が玄関の前で声をかけてくるという話があります。お子さんやお年寄りの方は、夜間に不用意にドアを開けないようにしてください。（詳細は確認できていません。不確かな情報は広めないでください）近所の方にも教えてあげてください。知り合いが黒いジャケットの二人組を見たそうです。", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-ja-group_forward-3", "provenance": "authored-r3-v1"}
{"id": "ja-test-03042", "split": "test", "lang": "ja", "region": "JP", "package": "org.telegram.messenger", "app_name": "Telegram", "app_category": "messaging", "usecase": "group_forward", "sender_type": "group", "title": "読書会 - 西村さん", "text": "皆さんに健康記事を転送します。毎日コップ8杯の白湯を飲むと血圧が下がり、不眠も治るそうです。タイトルは魅力的ですが、出典が見つかりませんでした。参考程度にしてください。週末の読書会は予定どおり、公民館の3階で行います。血圧が高い方は、薬を自己判断でやめず、まず医師に相談してください。", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-ja-group_forward-4", "provenance": "authored-r3-v1"}
{"id": "ja-dev-03043", "split": "dev", "lang": "ja", "region": "JP", "package": "jp.naver.line.android", "app_name": "LINE", "app_category": "messaging", "usecase": "group_event_info", "sender_type": "group", "title": "マンション管理組合 - 高橋", "text": "住民の皆さん、今週土曜日の午前9時から、中庭でごみの分別説明会を開催します。お子さんと一緒の参加も歓迎です。当日はエコバッグと景品を配布します。また、来週水曜日からエレベーターの点検で2時間ほど停止しますので、時間をずらしてご利用ください。ご協力ありがとうございます。申し込みは金曜の夜までです。", "urgentIn": [], "difficulty": "near_miss", "template_family": "r3-ja-group_event_info-1", "provenance": "authored-r3-v1"}
{"id": "ja-test-03044", "split": "test", "lang": "ja", "region": "JP", "package": "org.telegram.messenger", "app_name": "Telegram", "app_category": "messaging", "usecase": "group_event_info", "sender_type": "group", "title": "学区保護者会 - 林先生", "text": "保護者の皆様、来週月曜日に学校で保護者会を行います。時間は15時30分から、校舎2号館の講堂です。期末試験の復習予定と休み中の生活について説明します。できるだけ時間通りにお越しください。特別な事情がある場合は事前に担任へお知らせください。会の後、成績表の見方もご案内します。", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-ja-group_event_info-2", "provenance": "authored-r3-v1"}
{"id": "ja-test-03045", "split": "test", "lang": "ja", "region": "JP", "package": "com.whatsapp", "app_name": "WhatsApp", "app_category": "messaging", "usecase": "group_event_info", "sender_type": "group", "title": "地域ボランティア - 世話役", "text": "今度の日曜日午前8時30分に公園に集合し、川の清掃ボランティアを行います。所要時間は約2時間です。軍手と水筒は各自でご用意ください。ごみ袋は当日配布します。参加される方はグループで「参加します」と返信してください。終わったあとは簡単な昼食を一緒にとりましょう。", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-ja-group_event_info-3", "provenance": "authored-r3-v1"}
{"id": "ja-dev-03046", "split": "dev", "lang": "ja", "region": "JP", "package": "com.google.android.cellbroadcastreceiver", "app_name": "Wireless emergency alerts", "app_category": "emergency", "usecase": "community_safety_notice", "sender_type": "service", "title": "緊急速報", "text": "【緊急情報】大雨の影響で、このエリアの一部道路が冠水するおそれがあります。低い場所を避け、車で水の中を走行しないでください。危険を感じたら119番に通報し、高い場所で救助を待ってください。川沿いや地下駐車場には近づかないでください。最新の公式情報にご注意ください。", "urgentIn": ["Commute", "Deep Work / Focus", "Do Not Disturb (DND)", "Sleeping / Rest", "Workout / Gym"], "difficulty": "easy", "template_family": "r3-ja-community_safety_notice-1", "provenance": "authored-r3-v1"}
{"id": "ja-test-03047", "split": "test", "lang": "ja", "region": "JP", "package": "jp.naver.line.android", "app_name": "LINE", "app_category": "messaging", "usecase": "community_safety_notice", "sender_type": "group", "title": "マンション管理組合 - 管理人", "text": "緊急連絡です。3号棟でガス漏れが発生しました。ガス会社にはすでに連絡済みで、こちらへ向かっています。全住戸はガスの元栓をすぐに閉め、窓を開けて換気してください。火気や電気のスイッチは使わず、速やかに中庭に集合してください。お年寄りやお子さんがいるご家庭は、必ず声をかけてください。", "urgentIn": ["Commute", "Deep Work / Focus", "Do Not Disturb (DND)", "Sleeping / Rest", "Workout / Gym"], "difficulty": "easy", "template_family": "r3-ja-community_safety_notice-2", "provenance": "authored-r3-v1"}
{"id": "ja-test-03048", "split": "test", "lang": "ja", "region": "JP", "package": "jp.naver.line.android", "app_name": "LINE", "app_category": "messaging", "usecase": "community_safety_notice", "sender_type": "group", "title": "地域安全情報 - 町内会", "text": "緊急：マンション東側で火災が起きたため、住民の避難が行われています。1号棟から6号棟の方は、すぐに避難経路から北側の広場へ向かってください。エレベーターは使わず、荷物を取りに戻らないでください。消防隊が到着しています。現場の係員の指示に従ってください。逃げ遅れた人がいたら、すぐに119番へ連絡してください。", "urgentIn": ["Commute", "Deep Work / Focus", "Do Not Disturb (DND)", "Sleeping / Rest", "Workout / Gym"], "difficulty": "easy", "template_family": "r3-ja-community_safety_notice-3", "provenance": "authored-r3-v1"}
{"id": "ja-test-03049", "split": "test", "lang": "ja", "region": "JP", "package": "com.amazon.dee.app", "app_name": "Alexa", "app_category": "smart_home", "usecase": "visitor_gate", "sender_type": "service", "title": "Alexa", "text": "来客のお知らせです。山田様が正面玄関に到着し、入館の登録を進めています。登録は約3分で完了する見込みです。来訪者は紙袋を持っており、管理人が一時的に預かっています。ご都合がよいときにアプリで二階へ上がってよいか確認してください。不要な場合はそのまま登録を拒否できます。", "urgentIn": [], "difficulty": "near_miss", "template_family": "r3-ja-visitor_gate-7", "provenance": "authored-r3-v1"}
{"id": "ja-dev-03050", "split": "dev", "lang": "ja", "region": "JP", "package": "com.google.android.apps.chromecast.app", "app_name": "Google Home", "app_category": "smart_home", "usecase": "visitor_gate", "sender_type": "service", "title": "Google Home", "text": "玄関のカメラが、配達員が扉を開けるのを待っている様子を検知しました。生鮮食品の配達だと言っています。アプリでライブ映像を確認し、入室を許可するかどうか選べます。何もしない場合、この通知は5分後に自動で閉じられ、荷物は玄関の指定ボックスに入ります。", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-ja-visitor_gate-8", "provenance": "authored-r3-v1"}
{"id": "ja-test-03051", "split": "test", "lang": "ja", "region": "JP", "package": "com.philips.lighting.hue2", "app_name": "Philips Hue", "app_category": "smart_home", "usecase": "visitor_gate", "sender_type": "service", "title": "Philips Hue", "text": "今日の来客記録が更新されました。午後に二人の訪問者がマンションに入りました。引っ越し業者のスタッフと、設備点検の担当者です。どちらも登録済みです。詳細な記録は端末の画面から確認できます。質問がある場合は管理会社へお問い合わせください。日常的なお知らせなので、すぐに対応する必要はありません。", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-ja-visitor_gate-9", "provenance": "authored-r3-v1"}
