{"id": "gu-test-03017", "split": "test", "lang": "gu", "region": "IN", "package": "com.whatsapp", "app_name": "WhatsApp", "app_category": "messaging", "usecase": "group_chatter", "sender_type": "group", "title": "સોસાયટી ગ્રુપ - રાજેશ", "text": "અરે બધાં, કાલ રાતે પાર્કિંગમાં કોઈની ગાડીને ઘસરકો પડ્યો હતો એવું કોઈને ખબર છે? મેં તો કંઈ જોયું નથી. રવિવારની મીટિંગમાં કોણ આવશે? અને કોઈએ ગ્રુપમાં ખર્ચની યાદી મૂકી નથી ને?", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-gu-group_chatter-1", "provenance": "authored-r3-v1"}
{"id": "gu-test-03018", "split": "test", "lang": "gu", "region": "IN", "package": "org.telegram.messenger", "app_name": "Telegram", "app_category": "messaging", "usecase": "group_chatter", "sender_type": "group", "title": "કોલેજ મિત્રો", "text": "ભાઈઓ, આજે સાંજે ક્રિકેટ રમવા કોણ આવે છે? હું છ વાગ્યે ગ્રાઉન્ડ પર પહોંચીશ. ગયા વખતે કોઈએ બૉલ ગાયબ કરી દીધો હતો, આ વખતે તમે જ લાવજો! પછી પાણીપુરી ખાવા જઈએ? મને બહુ ભૂખ લાગી છે.", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-gu-group_chatter-2", "provenance": "authored-r3-v1"}
{"id": "gu-test-03019", "split": "test", "lang": "gu", "region": "IN", "package": "com.google.android.apps.messaging", "app_name": "Messages", "app_category": "messaging", "usecase": "group_chatter", "sender_type": "group", "title": "ઓફિસ ટીમ (6 સભ્યો)", "text": "હાય બધાને, ચાના પૈસા ભેગા કરવાના છે, દરેકના 20 રૂપિયા. શુક્રવારે ઓફિસ પાર્ટી પણ નક્કી થઈ છે. કોઈને એલર્જી હોય તો જણાવજો. અને પ્લીઝ, પછી નહીં, અત્યારે જ જવાબ આપજો.", "urgentIn": [], "difficulty": "near_miss", "template_family": "r3-gu-group_chatter-3", "provenance": "authored-r3-v1"}
{"id": "gu-dev-03020", "split": "dev", "lang": "gu", "region": "IN", "package": "com.whatsapp.w4b", "app_name": "WhatsApp Business", "app_category": "messaging", "usecase": "group_chatter", "sender_type": "group", "title": "નાસ્તા ગ્રુપ", "text": "સવારનો ઢોકળા કોણ બનાવશે? હું બપોરે આવીશ, આજે તીખું નહીં હોં! ગયા વખતની જેમ બે ડબ્બા ભૂલતા નહીં. કોઈએ ફોટા પાડ્યા હોય તો શેર કરજો, મારે જોઈએ છે.", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-gu-group_chatter-4", "provenance": "authored-r3-v1"}
{"id": "gu-test-03021", "split": "test", "lang": "gu", "region": "IN", "package": "com.whatsapp", "app_name": "WhatsApp", "app_category": "messaging", "usecase": "group_forward", "sender_type": "group", "title": "પરિવાર ગ્રુપ", "text": "બધાને સુપ્રભાત 🌞 ભગવાનનું નામ લઈને દિવસ શરૂ કરો. આ સંદેશ દસ લોકોને ફોરવર્ડ કરશો તો સારું થશે એવું કહેવાય છે. કોઈ તોડતા નહીં, આ નસીબની સાંકળ છે!", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-gu-group_forward-1", "provenance": "authored-r3-v1"}
{"id": "gu-test-03022", "split": "test", "lang": "gu", "region": "IN", "package": "org.telegram.messenger", "app_name": "Telegram", "app_category": "messaging", "usecase": "group_forward", "sender_type": "group", "title": "ઓફિસ મિત્રો 📢", "text": "આ સમાચાર સાચા છે? કાલે અમારી સોસાયટીમાં પાણી બંધ રહેશે એવું કોઈ કહેતું હતું. મને બરાબર ખબર નથી, છતાં બધાને મોકલીએ? કૃપા કરીને ખાતરી કરીને ફોરવર્ડ કરજો.", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-gu-group_forward-2", "provenance": "authored-r3-v1"}
{"id": "gu-dev-03023", "split": "dev", "lang": "gu", "region": "IN", "package": "com.mygate.user", "app_name": "MyGate", "app_category": "community", "usecase": "group_forward", "sender_type": "group", "title": "સોસાયટી ફોરવર્ડ", "text": "ગણેશ વિસર્જનનો ફોટો મોકલું છું, બહુ સરસ છે. આ સંદેશ બધા પડોશીઓને મોકલજો, આપણી સોસાયટીમાં બધાએ આ જોવું જોઈએ. નવા વર્ષની શુભેચ્છાઓ પણ!", "urgentIn": [], "difficulty": "hard_negative", "template_family": "r3-gu-group_forward-3", "provenance": "authored-r3-v1"}
{"id": "gu-test-03024", "split": "test", "lang": "gu", "region": "IN", "package": "com.mygate.user", "app_name": "MyGate", "app_category": "community", "usecase": "group_event_info", "sender_type": "service", "title": "સોસાયટી વહીવટ", "text": "બધા સભ્યોને જણાવવાનું કે શનિવારે સવારે 9 વાગ્યે સોસાયટીની સભા છે. વિષય: પાર્કિંગ અને જાળવણી ખર્ચ. કૃપા કરીને સમયસર હાજર રહો અથવા પ્રતિનિધિ મોકલો.", "urgentIn": [], "difficulty": "near_miss", "template_family": "r3-gu-group_event_info-1", "provenance": "authored-r3-v1"}
