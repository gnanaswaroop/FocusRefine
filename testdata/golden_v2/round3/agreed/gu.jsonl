{"id": "gu-dev-03026", "split": "dev", "lang": "gu", "region": "IN", "package": "com.google.android.apps.messaging", "app_name": "Messages", "app_category": "messaging", "usecase": "group_event_info", "sender_type": "group", "title": "શાળા વાલી ગ્રુપ", "text": "કાલે શાળામાં વાલી-શિક્ષક સભા બપોરે બે વાગ્યે છે. વર્ગ શિક્ષિકા મીનાબહેન વર્ગમાં મળશે. નોટબુકનો નવો ભાગ બાકી છે, સાથે લાવજો. આવતા અઠવાડિયાની રજાની વિગત પછી મોકલીશું.", "urgentIn": [], "difficulty": "near_miss", "template_family": "r3-gu-group_event_info-3", "provenance": "authored-r3-v1"}
{"id": "gu-test-03027", "split": "test", "lang": "gu", "region": "IN", "package": "com.mygate.user", "app_name": "MyGate", "app_category": "community", "usecase": "community_safety_notice", "sender_type": "service", "title": "સોસાયટી તાત્કાલિક સૂચના", "text": "બ્લોક B ની બિલ્ડિંગમાં ધુમાડો દેખાય છે અને ફાયર અલાર્મ વાગી રહ્યો છે. બધાએ તરત લિફ્ટ વાપર્યા વિના દાદરથી નીચે આવો. ફાયર બ્રિગેડ આવી રહી છે, કોઈએ અંદર ન જવું.", "urgentIn": ["Commute", "Deep Work / Focus", "Do Not Disturb (DND)", "Sleeping / Rest", "Workout / Gym"], "difficulty": "easy", "template_family": "r3-gu-community_safety_notice-1", "provenance": "authored-r3-v1"}
